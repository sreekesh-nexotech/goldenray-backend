:00","updated_at":"2026-09-28T17:39:32.075896+00:00"}, {"id":4,"brand":"Growatt","name":"MIN 5000TL-X2 (Pro)","inverter_type":"string","rating_tier":"value","image_url":"","description":"Highest peak efficiency in this set at 98.4%, IP66, and the widest operating range (-30 to 60 C) - at a value price. Type II DC surge protection is built in; AC surge protection and arc-fault detection are optional, and no corrosion class is published, so keep it under cover and away from direct sea air. Indian distributors list 8-10 years of warranty, though Growatt's own base term is 5. Solid for cost-conscious inland homes.","rated_output_power":5000,"maximum_dc_input":7500,"mppt_trackers":2,"maximum_dc_voltage":550,"maximum_input_current":"16 A per MPPT","weight":10.80,"display":"LED + ShinePhone app","suitable_system_size":"Ideal for 5 kW homes","maximum_efficiency":98.40,"european_efficiency":97.50,"mppt_efficiency":99.50,"dc_oversizing":150,"ac_overloading":110,"pid_protection":false,"iv_curve_scanning":"Not available","ip_rating":"IP66","corrosion_protection":"Not specified","operating_temperature":"-30°C to 60°C","cooling":"Natural convection","noise_level":"<25 dB","dc_surge_protection":"Built-in Type II","ac_surge_protection":"Optional","arc_fault_detection":"Optional","grid_protection":true,"monitoring_app":"ShinePhone","real_time_monitoring":true,"remote_diagnostics":"Basic alerts","firmware_updates":"OTA Updates","connectivity":"WiFi / 4G (ShineWiFi-X)","warranty_years":8,"extendable_warranty_years":10,"certifications":["IEC 62109", "IEC 61727", "IEC 62116", "BIS"],"brand_trust":"Very Good","year_founded":2011,"countries_served":"100+ Countries","global_installations":"","price_range":"₹₹","kerala_climate_score":86,"efficiency_rating":99,"reliability_rating":88,"warranty_rating":86,"kerala_climate_rating":86,"overall_rating":"very-good","created_at":"2026-09-28T17:39:32.080289+00:00","updated_at":"2026-09-28T17:39:32.080299+00:00"}, {"id":5,"brand":"Huawei","name":"SUN