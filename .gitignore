# Agent worktrees (parallel work packages check out nested worktrees here) — never part of the tree
.claude/

# Runtime state (dev RSA keys, dev Fernet key, local media)
var/

# Local Redis snapshots (a dev redis-server started in the repo writes dump.rdb here) — data dumps never go to git
*.rdb

# Environment files never go to git
.env*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/

# Build / collected output (uploaded media lives under var/, which is ignored above; the `media` app is source)
staticfiles/

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml

# Editors / OS
.idea/
.vscode/
.DS_Store
