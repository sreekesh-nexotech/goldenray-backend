# Copy to .env (never commit it). Keys only; values are set per environment.
DJANGO_SETTINGS_MODULE=
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Role the app connects as when migrations run as a separate owner role (audit_log append-only, docs/ops/audit-log.md)
DB_APP_ROLE=

REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=
FERNET_KEYS=

API_DOCS_PUBLIC=
# CIDRs allowed to open /api/docs/ and /api/schema/ when API_DOCS_PUBLIC is off (prod); mirror deploy/nginx/snippets/docs-allow.conf
API_DOCS_ALLOWED_NETWORKS=
SECURE_HSTS_SECONDS=
LOG_LEVEL=
MEDIA_ROOT=

EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=
# Studio page that completes a password reset (https in prod)
PASSWORD_RESET_URL=
# Public website origin used in JSON-LD, previews and sitemap entries (e.g. https://flarize.com)
FRONTEND_BASE_URL=

ACCOUNTS_LOGIN_LOCKOUT_MINUTES=
ACCOUNTS_LOGIN_MAX_FAILURES_PER_EMAIL=
ACCOUNTS_LOGIN_MAX_FAILURES_PER_IP=
ACCOUNTS_SESSION_MAX_AGE_DAYS=

# Media (public: bunny in staging/prod, local in dev; private files never leave PRIVATE_MEDIA_ROOT)
MEDIA_PUBLIC_BACKEND=
PUBLIC_MEDIA_ROOT=
PUBLIC_MEDIA_URL=
PRIVATE_MEDIA_ROOT=
# True behind nginx: private downloads are served by nginx via X-Accel-Redirect to /media/private/
USE_X_ACCEL=
# Bunny env fallback (an enabled BUNNY integration in Studio → Settings → Integrations takes precedence)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ENDPOINT=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_CDN_BASE_URL=

# Documents (playwright in staging/prod; stub renders placeholder PDFs)
DOCUMENTS_RENDERER=
DOCUMENTS_CHROMIUM_EXECUTABLE=
# https hosts document templates may load images from (the CDN host); everything else is blocked while rendering
DOCUMENTS_ALLOWED_ASSET_HOSTS=

# Weekly ops report and healthz alerts (comma-separated)
OPS_EMAILS=

# gunicorn (deploy/gunicorn.conf.py; defaults 4 workers × 8 threads)
GUNICORN_WORKERS=
GUNICORN_THREADS=
