# Container settings for the local Docker stack (deploy/docker-compose.dev.yml). Copy to .env.docker (git-ignored) — dev values only, never
# real secrets. DB/Redis host wiring is set by the compose file; the keys below are the knobs worth turning locally.
# Full list of settings: .env.example.

# Postgres (the container is created with these on first start; changing them later needs `make reset`)
DB_NAME=flarize
DB_USER=postgres
DB_PASSWORD=postgres

# Django (flarize.settings.dev: dev JWT/Fernet keys are generated into var/keys/, e-mail goes to the console)
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],api
CORS_ALLOWED_ORIGINS=http://localhost:3003
FRONTEND_BASE_URL=http://localhost:3003
PASSWORD_RESET_URL=http://localhost:3000/studio/reset-password
LOG_LEVEL=INFO

# Super Admin created by the setup service on first `up` (prints a one-time set-password link in `make logs-setup`)
DEV_ADMIN_EMAIL=admin@flarize.local

# Media on the local filesystem (var/media), served by Django while DEBUG
MEDIA_PUBLIC_BACKEND=local

# Documents: stub writes placeholder PDFs. For real PDFs set WITH_CHROMIUM=1 in the root .env, DOCUMENTS_RENDERER=playwright here, and rebuild.
DOCUMENTS_RENDERER=stub

# Website OTP: fake accepts 000000 for every phone
LEADS_OTP_BACKEND=fake

# EMI calculator price source: MANUAL or PACK_RELEASE
EMI_PRICE_SOURCE=MANUAL

# Content Studio single sign-in: the CMS DJANGO_SECRET_KEY (empty = Studio tokens not accepted).
STUDIO_JWT_SIGNING_KEY=
