 "content_content_block": [
  {
   "id": 1,
   "component": "shared.rich-text",
   "body": [
    {
     "type": "heading",
     "level": 2,
     "children": [
      {
       "text": "Understanding the subsidy slabs",
       "type": "text"
      }
     ]
    },
    {
     "type": "paragraph",
     "children": [
      {
       "text": "The subsidy is tiered by system capacity.",
       "type": "text"
      }
     ]
    },
    {
     "type": "paragraph",
     "children": [
      {
       "text": "[TABLE]",
       "type": "text"
      }
     ]
    },
    {
     "type": "paragraph",
     "children": [
      {
       "text": "| Capacity | Central Subsidy |",
       "type": "text"
      }
     ]
    },
    {
     "type": "paragraph",
     "children": [
      {
