 "content_entry": [
  {
   "id": 1,
   "document_id": "e6748356-b991-4ece-8c3a-146b9c03ecf4",
   "title": "PM Surya Ghar Subsidy: A Complete Kerala Guide",
   "slug": "pm-surya-ghar-subsidy-guide",
   "excerpt": "Everything Kerala homeowners need to know about the PM Surya Ghar rooftop solar subsidy.",
   "summary": [
    {
     "type": "list",
     "format": "unordered",
     "children": [
      {
       "type": "list-item",
       "children": [
        {
         "text": "Up to ₹78,000 central subsidy for rooftop solar.",
         "type": "text"
        }
       ]
      },
      {
       "type": "list-item",
       "children": [
        {
         "text": "Applies to residential connections in Kerala via the national portal.",
         "type": "text"
        }
       ]
      },
      {
       "type": "list-item",
       "children": [
        {
         "text": "Payback typically under 5 years with KSEB net-metering.",
         "type": "text"
        }
       ]
      }
     ]
    }
   ],
   "introduction": [
    {
     "type": "paragraph",
     "children": [
      {
       "text": "The PM Surya Ghar Muft Bijli Yojana makes rooftop solar dramatically more affordable for Kerala households. This guide walks through eligibility, the subsidy slabs, and how to apply.",
       "type": "text"
      }
     ]
    }
   ],
   "read_time": 6,
   "is_featured": true,
   "sort_order": 1,
   "published_on": "2026-09-28T17:40:00.391746+00:00",
   "warning": "Subsidy slabs are revised periodically — always confirm current rates on the national portal before applying.",
   "insights": "Households that pair a 3 kW system with net-metering see the fastest payback in Kerala's tariff structure.",
   "status": "published",
   "published_at": "2026-09-28T17:40:00.417587+00:00",
   "created_at": "2026-09-28T17:40:00.392205+00:00",
