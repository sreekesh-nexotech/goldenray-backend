# Copy to .env in the repository root (git-ignored). Docker Compose reads it, so plain `docker compose ps|logs|up`
# targets the local dev stack. Compose-only knobs here: never app settings or secrets — python-decouple also reads this
# file. Container settings and DB credentials go in .env.docker.
COMPOSE_FILE=deploy/docker-compose.dev.yml

# Containers run as this host user so var/ (dev keys, media) stays yours: set to `id -u` / `id -g` (make sets them itself)
LOCAL_UID=1000
LOCAL_GID=1000

# Ports are bound to this address only. Keep 127.0.0.1: Docker-published ports bypass the host firewall, and an exposed
# dev Postgres on this machine was taken over by a botnet within an hour. Use an SSH tunnel for remote access.
PUBLISH_ADDR=127.0.0.1
API_PUBLISH_PORT=8000
DB_PUBLISH_PORT=5433
REDIS_PUBLISH_PORT=6380

# Real PDFs: set to 1 (plus DOCUMENTS_RENDERER=playwright in .env.docker) and rebuild
WITH_CHROMIUM=0
